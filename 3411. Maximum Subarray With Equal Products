class Solution {
    public int findLCM(int n1,int n2)
    {
        int max = Math.max(n1,n2);
        int i = 1;
        while(true)
        {
         int temp = max*i;
         if((temp%n1==0)&&(temp%n2==0))
         return temp;
         i++;
        }
    }
    public int findGCD(int n1,int n2)
    {
      int i = 1,ans = 0;
      while(i<=Math.min(n1,n2))
      {
        if(n1%i==0&&n2%i==0)
        {
            ans = i;
        }
        i++;
      }
      return ans;
    }
    public int maxLength(int[] nums) {
        int maxLen = 1;
        for(int i=0;i<nums.length;i++)
        {
            int pro = nums[i];
            int lcm = nums[i],gcd = nums[i];
           for(int j=i+1;j<nums.length;j++)
           {
             pro = pro*nums[j];
             lcm = findLCM(nums[j],lcm);
             gcd = findGCD(nums[j],gcd);
             if(pro==lcm*gcd)
             {
                maxLen = Math.max(maxLen,j-i+1);
             }
           }
        }
        return maxLen;
    }
}
